      "nspname": "market_factors_20250901_20260731_v1",
      "relname": "market_internal_causal_v38",
      "definition": " SELECT universe_definition,\n    session_date,\n    securities AS full_securities,\n    return_observed AS full_return_observed,\n    advancers AS full_advancers,\n    decliners AS full_decliners,\n    unchanged AS full_unchanged,\n    pct_advancing AS full_pct_advancing,\n    advance_decline_ratio AS full_advance_decline_ratio,\n    equal_weight_ret_1d AS full_equal_weight_ret_1d,\n    median_ret_1d AS full_median_ret_1d,\n    dispersion_ret_1d AS full_dispersion_ret_1d,\n    return5_observed AS full_return5_observed,\n    return20_observed AS full_return20_observed,\n    pct_positive_5d AS full_pct_positive_5d,\n    pct_positive_20d AS full_pct_positive_20d,\n    aggregate_dollar_volume AS full_aggregate_dollar_volume,\n    return_observed::double precision / NULLIF(securities, 0)::double precision AS full_return_coverage_ratio,\n    event_time,\n    available_at,\n    source_observed_at,\n    ingested_at,\n    definition_version,\n    quality_flags\n   FROM market_factors_20250901_20260731_v1.market_internal_adjusted_v38;"
