    {
      "nspname": "market_factors_20250901_20260731_v1",
      "relname": "security_daily_features_serving_remediated_v1",
      "definition": " SELECT f.instrument_key,\n    f.session_date,\n    f.source_code,\n    f.observed_bars,\n    f.expected_bars,\n    f.quality_flags,\n    f.identity_anchor,\n    f.raw_close,\n    f.raw_volume,\n    f.provider_dollar_volume,\n    f.source_observed_at,\n    f.assumed_available_at,\n    f.raw_ret_1d,\n    f.ret_1d,\n    f.ret_5d,\n    f.ret_20d,\n    f.ret_60d,\n    f.realized_log_vol_20d,\n    f.relative_volume_20d,\n    f.volume_z20,\n    f.amihud_mean_20d,\n    f.valid_close_count_61,\n    f.source_age_seconds,\n    f.built_at,\n    'ARCHIVED_FINAL_BAR_PROXY_RETROSPECTIVE_IDENTITY'::text AS historical_usability,\n    false AS original_receipt_replay_certified,\n    'RAW_SIP_PRICE_KNOWN_MAPPED_ACTIONS_ONLY_SPLIT_RETURNS'::text AS price_basis,\n    'market_data_remediation_20261008_v1'::text AS release_id\n   FROM market_factors_20250901_20260731_v1.security_daily_features_remediated_v1 f\n  WHERE NOT (EXISTS ( SELECT 1\n           FROM market_governance.equity_daily_affected_dates_v3 a\n          WHERE a.instrument_key = f.instrument_key AND a.session_date = f.session_date))\nUNION ALL\n SELECT f.instrument_key,\n    f.session_date,\n    f.source_code,\n    f.observed_bars,\n    f.expected_bars,\n    f.quality_flags,\n    f.identity_anchor,\n    f.raw_close,\n    f.raw_volume,\n    f.provider_dollar_volume,\n    f.source_observed_at,\n    f.assumed_available_at,\n    f.raw_ret_1d,\n    f.ret_1d,\n    f.ret_5d,\n    f.ret_20d,\n    f.ret_60d,\n    f.realized_log_vol_20d,\n    f.relative_volume_20d,\n    f.volume_z20,\n    f.amihud_mean_20d,\n    f.valid_close_count_61,\n    f.source_age_seconds,\n    f.built_at,\n    'ARCHIVED_FINAL_BAR_PROXY_RETROSPECTIVE_IDENTITY'::text AS historical_usability,\n    false AS original_receipt_replay_certified,\n    'RAW_UNADJUSTED_VALIDATED_SUPPLEMENTAL_KNOWN_MAPPED_ACTIONS_ONLY_SPLIT_RETURNS'::text AS price_basis,\n    'listed_equity_daily_patch_20261009_v1'::text AS release_id\n   FROM market_factors_20250901_